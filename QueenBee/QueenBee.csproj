<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>

		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<AssemblyTitle>Queen Bee</AssemblyTitle>
		<Description>PAK / QB Explorer, Editor</Description>
		<Company>Nanook</Company>
		<Product>Queen Bee</Product>
		<AssemblyTrademark></AssemblyTrademark>
		<AssemblyCulture></AssemblyCulture>

		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<AssemblyFileVersion>2.0.0.0</AssemblyFileVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="App.ico" />
		<Content Include="Info\Release.nfo.txt" />
		<Content Include="Info\TODO.txt" />
		<Content Include="Info\ZLib.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\QueenBeeParser\QueenBeeParser.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="EditorForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="EditPakItem.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="InfoForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="QbItemEditors\GenericQbEditItem.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="QbItemEditors\GenericQbItemEditor.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="QbItemEditors\QbItemEditorBase.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="QbItemEditors\ScriptEditor.cs">
			<SubType>UserControl</SubType>
		</Compile>
		<Compile Update="QbItemEditors\SimpleArrayEditor.cs">
			<SubType>UserControl</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="EditorForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="EditPakItem.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="InfoForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="QbItemEditors\GenericQbEditItem.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="QbItemEditors\GenericQbItemEditor.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="QbItemEditors\QbItemEditorBase.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="QbItemEditors\ScriptEditor.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="QbItemEditors\SimpleArrayEditor.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

</Project>